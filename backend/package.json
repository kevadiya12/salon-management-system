{
  "name": "salon-queue-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "seed:owner": "tsx src/seed-owner.ts",
    "seed:demo": "tsx src/seed-demo.ts",
    "test": "tsx --test test/auth.api.test.ts test/reception.service.test.ts test/reception.api.test.ts test/socket.events.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "jose": "^6.2.18",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.16.5",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
